# Nora Mobile - Production Environment Variables
# This file is used for TestFlight and App Store builds

# Production Backend API URL (AWS App Runner)
#EXPO_PUBLIC_API_URL=https://wpwpawhz29.ap-southeast-1.awsapprunner.com
EXPO_PUBLIC_API_URL=https://p2tgddmyxt.us-east-1.awsapprunner.com

# Public web URL — base for /share-home-card.html and /share-lesson.html links.
# Prod uses signup.hinora.co (Vercel; web/vercel.json rewrites /share-*.html,
# /api/*, /images/*, /s/* to the prod App Runner backend). Dev has no domain so
# it uses the App Runner URL directly.
# NOTE: the backend also reads EXPO_PUBLIC_WEB_URL (shortlinks.cjs) to build the
# /s/<code> short link — keep the App Runner env var for each service in sync
# with the value here (dev → p2tgddmyxt URL, prod → https://signup.hinora.co).
# Toggled in lockstep with EXPO_PUBLIC_API_URL by deploy_dev.sh / deploy_prod.sh.
#EXPO_PUBLIC_WEB_URL=https://signup.hinora.co
EXPO_PUBLIC_WEB_URL=https://p2tgddmyxt.us-east-1.awsapprunner.com

# Google OAuth Configuration (Production)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=773719197472-nf4vm9bjl2tve63ro7cf25fjrqb3t968.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=773719197472-0aib3ell35vj87uo3nkqrt06ae2knrpq.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=YOUR_ANDROID_CLIENT_ID_HERE.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=773719197472-nf4vm9bjl2tve63ro7cf25fjrqb3t968.apps.googleusercontent.com

EXPO_PUBLIC_IOS_STORE_URL=https://apps.apple.com/app/id6756343006
EXPO_PUBLIC_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.chromamind.nora

# Facebook OAuth Configuration (Production)
EXPO_PUBLIC_FACEBOOK_APP_ID=1860972418638002
